<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head") %>
  </head>
  <body>
    <%- include("partials/header") %>
    <main class="main-wrapper">
      <% if(locals.user) { %>
        <a href="/new-message">New message</a>
      <% } %>
      <div class="messages">
        <% messages.forEach(message => { %>
          <div class="message-container">
            <div class="user-info">
              <p class="user-fullname"><%= locals.user ? `${message.first_name} ${message.last_name}` : '*** ***' %></p>
              <p class="username"><%= locals.user ? message.username : '*****' %></p>
              <p class="date-posted"><%=locals.user ? message.created_at : '*** ** ***' %></p>
            </div>
            <div class="message-data">
              <h3 class="message-title"><%= message.title %></h3>
              <p class="message-body"><%= message.body %></p>  
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
