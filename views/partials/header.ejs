<header class="main-header">
  <div class="home">
    <a href="/" class="home-btn">Members Only</a>
  </div>
  <div class="header-right-links">
    <% if (locals.user) { %>
      <% if(!locals.user.membership) { %>
      <a href="/join-club" class="header-link joinclub-btn">Join Club</a>
      <% } %>
      <a href="/logout" class="header-link logout-btn">Log out</a>
    <% } else { %>
      <a href="/login" class="header-link login-btn">Log in</a>
      <a href="/signup" class="header-link signup-btn"> Sign up</a>
    <% } %>
  </div>
</header>
